rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && isValidId(userId)
                    && incoming().userId == request.auth.uid
                    && incoming().email is string
                    && incoming().email.size() <= 200;
      allow update: if isSignedIn() && isOwner(userId) && isValidId(userId)
                    && incoming().userId == existing().userId;
      allow delete: if false;
    }

    // Projects collection
    match /projects/{projectId} {
      allow get, list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(projectId)
                    && incoming().userId == request.auth.uid
                    && incoming().name is string
                    && incoming().name.size() <= 100;
      allow update: if isSignedIn() && isValidId(projectId)
                    && existing().userId == request.auth.uid
                    && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(projectId)
                    && existing().userId == request.auth.uid;
    }
  }
}
