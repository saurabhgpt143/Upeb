{
  "entities": {
    "Project": {
      "title": "Project Specification",
      "description": "Building design project specs and metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "name": { "type": "string", "maxLength": 100, "description": "Project title or name" },
        "userId": { "type": "string", "maxLength": 128, "description": "Owner user ID" },
        "specs": { "type": "object", "description": "Detailed project specs" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["name", "userId", "specs"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Public profile info for authenticated user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "description": "Owner user ID" },
        "displayName": { "type": "string", "maxLength": 100, "description": "User display name" },
        "email": { "type": "string", "maxLength": 200, "description": "User email address" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["userId", "email"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Collection of building design projects"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Collection of user profiles"
    }
  }
}
